<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Sim</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap">
</head>
<body>
<style>
:root{
  --bg:#f3f1ec; --panel:#ffffff; --fg:#1d1f22; --muted:#5e6470; --line:#d7d3ca; --wire:#2b2d31; --wire-off:#c4c0b6; --grid:#ebe8e0; --box:rgba(29,31,34,.03);
  --accent:#b8541a; --on-accent:#ffffff;
  --c-ckt1:#0f8f83; --c-ckt2:#b43c8f; --c-ckt3:#d4861c; --c-bat:#2f6fd0; --fet-on:#cf3b2f;
  --ok:#2f8f4e; --warn:#c8871a;
  --d-ckt1:#0f8f83; --d-ckt2:#b43c8f; --d-ckt3:#d4861c; --d-bat:#2f6fd0; --d-off:#c4c0b6; --d-fault:#cf3b2f;
  --font-body:"IBM Plex Sans",system-ui,sans-serif; --font-mono:"IBM Plex Mono",ui-monospace,Menlo,monospace;
}
@media (prefers-color-scheme: dark){ :root:not([data-theme="light"]){
  --bg:#16181c; --panel:#1f2227; --fg:#e8e6e0; --muted:#9aa0ab; --line:#33373e; --wire:#dcd9d1; --wire-off:#4a4e56; --grid:#262a30; --box:rgba(232,230,224,.035);
  --accent:#e8884a; --on-accent:#16181c;
  --c-ckt1:#2ec7b6; --c-ckt2:#e06ac0; --c-ckt3:#f0a53a; --c-bat:#6ea2ff; --fet-on:#ff6a5c;
  --ok:#5ccf7f; --warn:#f0b24a; color-scheme:dark } }
:root[data-theme="dark"]{
  --bg:#16181c; --panel:#1f2227; --fg:#e8e6e0; --muted:#9aa0ab; --line:#33373e; --wire:#dcd9d1; --wire-off:#4a4e56; --grid:#262a30; --box:rgba(232,230,224,.035);
  --accent:#e8884a; --on-accent:#16181c;
  --c-ckt1:#2ec7b6; --c-ckt2:#e06ac0; --c-ckt3:#f0a53a; --c-bat:#6ea2ff; --fet-on:#ff6a5c;
  --ok:#5ccf7f; --warn:#f0b24a; color-scheme:dark }

html,body{height:100%;margin:0;overflow:hidden}
body{background:var(--bg);color:var(--fg);font-family:var(--font-body);font-size:14px;line-height:1.45}
#stage{position:absolute;left:0;top:0;width:1920px;height:1080px;box-sizing:border-box;padding:20px;transform-origin:0 0;display:grid;grid-template-columns:320px minmax(0,1fr);gap:16px}
.title{display:flex;flex-direction:column;gap:3px;padding:2px 2px 0}
h1{font-size:21px;font-weight:600;margin:0;line-height:1.2}
.title p{margin:0;font-size:12px;color:var(--muted)}
.rail,.main{display:flex;flex-direction:column;gap:10px;min-height:0;min-width:0}
.main{gap:16px}
.main .diag{flex:1;min-height:0;display:flex;flex-direction:column}
.hrow{display:flex;gap:6px}
.hrow button{flex:1;min-width:0}
.g2{display:grid;grid-template-columns:1fr 1fr;gap:6px}
.g2 button{padding:5px 9px}
.card{background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:10px 12px;min-width:0}
.card h2{font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin:0 0 10px;font-weight:600}
.stack{display:flex;flex-direction:column;gap:14px}
.modes{display:grid;grid-template-columns:1fr 1fr;gap:6px}
.modes.one{grid-template-columns:1fr}
button{font:inherit;color:var(--fg);background:transparent;border:1px solid var(--line);border-radius:6px;padding:6px 10px;cursor:pointer;text-align:left}
button:hover{border-color:var(--muted)}
button:focus-visible,.fet:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
button.on{background:var(--accent);border-color:var(--accent);color:var(--on-accent)}
.card button b{display:block;font-weight:600}
.card button span{display:block;font-size:11px;opacity:.8}
#swap.on{background:var(--d-ckt3);border-color:var(--d-ckt3);color:#1d1f22}
.fets button{display:flex;flex-direction:column;gap:2px}
.fets button.on{background:var(--fet-on);border-color:var(--fet-on);color:var(--on-accent)}
.fets button small{opacity:.85;font-size:11px}
.env{display:grid;grid-template-columns:auto 1fr auto 1fr;gap:4px 8px;font-size:12px;margin:8px 0 0;white-space:nowrap;align-items:center}
.env dt{color:var(--muted)}.env dd{margin:0;font-family:var(--font-mono);font-variant-numeric:tabular-nums}
.pill{display:inline-block;padding:1px 7px;border-radius:999px;font-size:11px;font-weight:600;font-family:var(--font-body)}
.pill.closed{background:color-mix(in srgb,var(--ok) 18%,transparent);color:var(--ok)}
.pill.open{background:color-mix(in srgb,var(--muted) 18%,transparent);color:var(--muted)}
.ctl{display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--muted)}
.ctl .row{display:flex;gap:8px;align-items:center}
.cin{display:grid;grid-template-columns:1fr auto auto;gap:4px 8px;align-items:center}
.cin .sw{display:inline-block;width:10px;height:10px;border-radius:2px;margin-right:6px;vertical-align:-1px}
input[type=range]{flex:1;accent-color:var(--accent);min-width:0}
input[type=number]{font:inherit;font-family:var(--font-mono);width:5.5em;background:var(--bg);color:var(--fg);border:1px solid var(--line);border-radius:4px;padding:3px 6px}
.diagram{position:relative;flex:1;min-height:0;background:#fff;border-radius:6px;--panel:#fff;--fg:#1d1f22;--muted:#5e6470;--line:#d7d3ca;--wire:#2b2d31;--wire-off:var(--d-off);--box:rgba(29,31,34,.03);--accent:#b8541a;--on-accent:#fff;--ok:#2f8f4e;--fet-on:var(--d-fault);--c-ckt1:var(--d-ckt1);--c-ckt2:var(--d-ckt2);--c-ckt3:var(--d-ckt3);--c-bat:var(--d-bat)}
svg{position:absolute;inset:0;width:100%;height:100%;display:block}
svg text{font-family:var(--font-body);fill:var(--fg)}
.lbl{font-size:13px}.lbl.sm{font-size:11px;fill:var(--muted)}
.lbl.tab{font-size:11px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;fill:var(--muted)}
.mono{font-family:var(--font-mono);font-variant-numeric:tabular-nums}
.wire{fill:none;stroke:var(--wire-off);stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.glow{fill:none;stroke-linecap:round;stroke-linejoin:round}
.dash{fill:none;stroke-linecap:butt;stroke-linejoin:round}
.sym{fill:none;stroke:var(--wire);stroke-width:2.2;stroke-linejoin:round;stroke-linecap:round}
.sym.fill{fill:var(--wire)}
.sym.body{fill:var(--panel)}
.box{fill:var(--box);stroke:var(--muted);stroke-width:1.3;stroke-dasharray:6 5;rx:4}
.dot{fill:var(--wire)}
.vchip rect{fill:var(--panel);stroke:var(--line);stroke-width:1;rx:8}
.vchip text{font-family:var(--font-mono);font-size:11.5px;font-variant-numeric:tabular-nums}
.vchip .nn{fill:var(--muted);font-family:var(--font-body);font-weight:600}
.vchip.float text{fill:var(--muted)}
.ichip{font-family:var(--font-mono);font-size:11px;font-variant-numeric:tabular-nums;font-weight:500;fill:var(--muted)}
.fet{cursor:pointer}
.fet .hit{fill:transparent}
.fet:hover .hit{fill:color-mix(in srgb,var(--accent) 10%,transparent)}
.fet .halo{fill:var(--fet-on);opacity:0;transition:opacity .25s}
.fet.on .halo{opacity:.16}
.fet.on .ch{stroke:var(--fet-on);stroke-width:3.6}
.fet .state{font-size:11px;font-weight:600;fill:var(--muted)}
.fet.on .state{fill:var(--fet-on)}
.diode{cursor:pointer}
.diode:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.diode .dhit{fill:transparent}
.diode:hover .dhit{fill:color-mix(in srgb,var(--accent) 10%,transparent)}
.diode.dead .sym{opacity:.3}
.fbadge{fill:var(--fet-on);stroke:var(--panel);stroke-width:1.5}
.fbadge-t{font-size:10px;font-weight:700;fill:var(--on-accent);font-family:var(--font-body)}
.hint{font-size:12px;color:var(--muted);margin:0 0 6px}
.flist{list-style:none;margin:0 0 8px;padding:0;font-size:12.5px}
.flist li{display:flex;justify-content:space-between;gap:8px;padding:3px 0;border-bottom:1px solid var(--line)}
.flist .fs{font-weight:600;color:var(--fet-on);text-transform:uppercase;font-size:11px;letter-spacing:.05em}
.tstat .lever{stroke:var(--ok);stroke-width:2.6;stroke-linecap:round;transition:transform .25s,stroke .25s;transform-box:fill-box;transform-origin:left center}
.tstat.open .lever{transform:rotate(-32deg);stroke:var(--muted)}
.tstat .st{font-size:11px;font-weight:600}
.tstat .st.closed{fill:var(--ok)}.tstat .st.open{fill:var(--muted)}
.legend{display:flex;flex-wrap:wrap;gap:4px 16px;font-size:12px;color:var(--muted);margin-top:8px;justify-content:center}
.legend i{display:inline-block;width:22px;height:4px;border-radius:2px;vertical-align:middle;margin-right:6px}
.legend .braid{background:repeating-linear-gradient(90deg,var(--d-ckt2) 0 6px,var(--d-ckt1) 6px 12px)}
.results{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:10px}
.kv{border:1px solid var(--line);border-radius:6px;padding:7px 10px}
.kv .k{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.06em}
.kv .v{font-family:var(--font-mono);font-size:20px;font-variant-numeric:tabular-nums;line-height:1.3}
.alert{margin:10px 0 0;padding:8px 10px;border:1px solid color-mix(in srgb,var(--fet-on) 40%,transparent);border-radius:6px;font-size:12.5px;color:var(--fet-on)}
</style>

<div id="stage">
  <div class="rail">
    <div class="card">
      <h2>Circuit</h2>
      <div class="stack" style="gap:6px">
        <button id="ckt-baseline"><b>BASELINE</b></button>
        <button id="ckt-proposed"><b>PROPOSED</b></button>
        <button id="swap" aria-pressed="false"><b>SWAP CKT 2 ↔ CKT 3</b></button>
      </div>
    </div>
    <div class="card">
      <h2>Mode of operation</h2>
      <div class="g2" id="modes"></div>
      <dl class="env">
        <dt>Temperature</dt><dd id="envT"></dd>
        <dt>Irradiance</dt><dd id="envIrr"></dd>
        <dt>AUX T‑stat</dt><dd id="envT1"></dd>
        <dt>MAIN T‑stat</dt><dd id="envT2"></dd>
      </dl>
    </div>
    <div class="card">
      <h2>Shunt FETs</h2>
      <div class="hrow fets">
        <button id="btnM2"><b>M2 · CKT 2</b><small></small></button>
        <button id="btnM3"><b>M3 · CKT 3</b><small></small></button>
      </div>
    </div>
    <div class="card">
      <h2>Parameters</h2>
      <div class="stack" style="gap:8px">
        <div class="ctl"><span>String currents, sum over the 8 panels, at the max-sum illumination</span>
          <div class="cin">
            <span><i class="sw" style="background:var(--d-ckt1)"></i>CKT 1 · 10s1p</span><input type="number" id="i1" min="0" max="20" step="0.01" value="1.3153"><span>A</span>
            <span><i class="sw" id="sw-i2" style="background:var(--d-ckt2)"></i>CKT 2 · 20s2p</span><input type="number" id="i2" min="0" max="20" step="0.01" value="2.6306"><span>A</span>
            <span><i class="sw" id="sw-i3" style="background:var(--d-ckt3)"></i>CKT 3 · 20s1p</span><input type="number" id="i3" min="0" max="20" step="0.01" value="1.3153"><span>A</span>
          </div></div>
        <div class="g2">
          <label class="ctl"><span>Diode drop, every diode</span>
            <div class="row"><input type="number" id="vf" min="0" max="3" step="0.05" value="0.7"><span>V</span></div></label>
          <label class="ctl"><span>Battery voltage</span>
            <div class="row"><input type="number" id="vbat" min="10" max="40" step="0.1" value="28"><span>V</span></div></label>
        </div>
        <div class="g2">
          <label class="ctl" title="Open-circuit voltage of a 20 s string; the 10 s CKT 1 gets half of it"><span>String V<sub>oc</sub>, 20 s</span>
            <div class="row"><input type="number" id="voc" min="10" max="120" step="1" value="55"><span>V</span></div></label>
          <label class="ctl"><span>Bus load</span>
            <div class="row"><input type="range" id="load" min="0" max="3" step="0.05" value="0.5"><span class="mono" id="loadV">0.50 A</span></div></label>
        </div>
        <button id="resetParams">Reset parameters</button>
      </div>
    </div>
    <div class="card">
      <h2>Diode faults</h2>
      <p class="hint">Click a diode: OK → shorted → open.</p>
      <ul class="flist" id="faultList"></ul>
      <button id="resetFaults">Clear all faults</button>
    </div>
  </div>

  <div class="main">
    <div class="card diag">
      <div class="diagram">
      <svg id="svg" viewBox="40 -14 945 622" xmlns="http://www.w3.org/2000/svg" aria-label="Solar array shunt and heater block diagram">
                <path class="box" id="pbox" d=""/>
        <path class="box" id="pbox2" d="M356 470 H440 V512 H356 Z"/>
        <text class="lbl tab" id="pnlLbl" x="66" y="0">Solar Panel ×8</text>
        <rect class="box" id="battBox" x="565" y="310" width="240" height="118"/>
        <text class="lbl tab" id="battTab" x="700" y="300">Batt ×4</text>
        <rect class="sym body" id="loadBox" x="860" y="329" width="88" height="44" rx="5"/>
        <text class="lbl" id="loadT" x="904" y="355" text-anchor="middle" style="font-size:12px;font-weight:600">LOAD</text>

        <g id="glows"></g>
        <g id="wires"></g>
        <g id="dashes"></g>
        <g id="arrows"></g>
        <g id="srcs"></g>
        <g id="diodes"></g>
        <g id="fets"></g>
        <text class="lbl" id="auxLbl" transform="translate(586,392) rotate(-90)" style="font-size:12px">AUX HTR</text>
        <text class="lbl" id="mainLbl" transform="translate(664,394) rotate(-90)" style="font-size:12px">MAIN HTR</text>
                <line class="sym" id="bl1" x1="742" y1="346" x2="778" y2="346" stroke-width="3.4"/>
        <line class="sym" id="bl2" x1="750" y1="356" x2="770" y2="356"/>
        <text class="lbl" id="bplus" x="784" y="340" style="font-size:11px">+</text>
        <text class="lbl" transform="translate(796,392) rotate(-90)" style="font-size:12px" id="battLbl">28V nom</text>
        <g id="tstats"></g>
        <g id="gnds"></g>
        <g id="dots"></g>
        <g id="ichips"></g>
        <g id="vchips"></g>
      </svg>
      </div>
      <div class="legend">
        <span><i style="background:var(--d-ckt1)"></i>CKT 1 loop</span>
        <span id="lg-ckt2"><i style="background:var(--d-ckt2)"></i>CKT 2 loop</span>
        <span id="lg-ckt3"><i style="background:var(--d-ckt3)"></i>CKT 3 loop</span>
        <span><i style="background:var(--d-bat)"></i>Battery discharge loop</span>
        <span><i class="braid"></i>Wire shared by two loops</span>
        <span><i style="background:var(--d-off)"></i>No current</span>
        <span><b style="color:var(--d-fault)">S</b> / <b style="color:var(--d-fault)">O</b> badge: diode shorted / open</span>
        <span>≈ node has no solid reference; value set by diode leakage</span>
      </div>
    </div>
    <div class="card">
      <h2 id="resTitle">Readouts</h2>
      <div class="results" id="results"></div>
      <div id="alerts"></div>
    </div>
  </div>
</div>

<script>
(function(){
'use strict';
const RH=16.1;
const I_MIN=5e-3;
const DEF={i1:1.3153,i2:2.6306,i3:1.3153,vf:0.7,vbat:28,load:0.5,voc:55};
const MODES=[
  {id:'day',   name:'DAY',    desc:'full Sun, above 20 °C', T:'+60 °C', irr:1, t1:false, t2:false},
  {id:'night', name:'NIGHT',  desc:'dark, below 4 °C',       T:'−40 °C', irr:0, t1:true,  t2:true},
  {id:'dawn1', name:'DAWN 1', desc:'Sun just up, below 4 °C',     T:'−10 °C', irr:1, t1:true,  t2:true},
  {id:'dawn2', name:'DAWN 2', desc:'Sun up, 4 to 20 °C',    T:'+10 °C', irr:1, t1:true,  t2:false},
];
const CKT_NAMES={baseline:'BASELINE',proposed:'PROPOSED'};
const FAULTABLE=['D1','D2A','D2B','D3'];
const state={mode:'dawn1', ckt:'baseline', swap:false, m2:false, m3:false, faults:{}, ...DEF};
const NODE_NAMES=['N3','N2','N1','H','BUS','R1','A','B','HA'];
const NN=NODE_NAMES.length;
function solve(p){
  const G_SW=1e4,G_FET=100,G_D=1e3,G_BAT=1e4,VD=p.vf,LEAK=1e-12,G_LK=1e-7;
  const prop=p.ckt==='proposed', dark=(p.I1+p.I2+p.I3)===0;
  const F=p.faults||{}, fs=id=>F[id]||'ok';
  const lin=[{a:8,b:6,g:1/RH},{a:3,b:7,g:1/RH},{a:4,b:-1,g:G_BAT}];
  if(prop) lin.push({a:5,b:-1,g:G_SW}); else lin.push({a:3,b:8,g:G_SW});
  const D=[], gi={}, open={};
  [['D3',0,4,['D3']],['D2',1,3,['D2A']],['D4',prop?1:3,4,['D2B']],['D5',5,prop?-1:7,prop?[]:['D1']]].forEach(([n,a,c,ids])=>{
    if(!ids.length){gi[n]={tie:true,a,c};return;}
    let good=0,isOpen=false; ids.forEach(id=>{const f=fs(id);if(f==='open')isOpen=true;else if(f!=='short')good++;});
    open[n]=isOpen;
    if(isOpen){gi[n]={dis:true};}
    else if(good===0){gi[n]={tie:true,a,c};lin.push({a,b:c,g:G_SW});}
    else{gi[n]={idx:D.length};D.push({n,a,c,v:VD*good});}
  });
  const i1=D.length; D.push({n:'DB1',a:2,c:8,v:VD});
  const ic=D.length; D.push({n:'C1',a:2,c:5,v:p.voc/2,dis:dark,lk:true},{n:'C2',a:1,c:-1,v:p.voc,dis:dark,lk:true},{n:'C3',a:0,c:-1,v:p.voc,dis:dark,lk:true});
  if(p.m3)lin.push({a:0,b:-1,g:G_FET}); if(p.m2)lin.push({a:1,b:-1,g:G_FET});
  if(p.t1)lin.push({a:6,b:5,g:G_SW});   if(p.t2)lin.push({a:7,b:-1,g:G_SW});
  const inj=new Array(NN).fill(0);
  inj[0]+=p.I3; inj[1]+=p.I2; inj[2]+=p.I1; inj[5]-=p.I1; inj[4]+=p.vbat*G_BAT-p.load;
  let best=null;
  for(let m=0;m<(1<<D.length);m++){
    if(D.some((d,i)=>d.dis&&(m>>i&1)))continue;
    const A=Array.from({length:NN},()=>new Array(NN).fill(0)), b=inj.slice();
    for(let i=0;i<NN;i++)A[i][i]+=LEAK;
    const stamp=(a,c,g)=>{if(a>=0)A[a][a]+=g;if(c>=0)A[c][c]+=g;if(a>=0&&c>=0){A[a][c]-=g;A[c][a]-=g;}};
    lin.forEach(l=>stamp(l.a,l.b,l.g));
    D.forEach((d,i)=>{if(m>>i&1){stamp(d.a,d.c,G_D);if(d.a>=0)b[d.a]+=G_D*d.v;if(d.c>=0)b[d.c]-=G_D*d.v;}else if(!d.dis||d.lk){stamp(d.a,d.c,G_LK);}});
    const V=gauss(A,b); if(!V)continue;
    const vn=i=>i>=0?V[i]:0;
    let viol=0; const Id=[];
    D.forEach((d,i)=>{const vd=vn(d.a)-vn(d.c);
      if(m>>i&1){const I=G_D*(vd-d.v);Id.push(I);if(I<-1e-6)viol+=-I;}
      else{Id.push((!d.dis||d.lk)?G_LK*vd:0);if(!d.dis&&vd>d.v+1e-6)viol+=vd-d.v;}});
    if(!best||viol<best.viol){best={viol,V,Id,m};}
    if(viol===0)break;
  }
  const V=best.V, Id=best.Id;
  const edges=[]; lin.forEach(l=>edges.push([l.a,l.b])); D.forEach((d,i)=>{if((best.m>>i&1)&&Math.abs(Id[i])>1e-4)edges.push([d.a,d.c]);});
  const seen=new Set([-1]); let grow=true;
  while(grow){grow=false;edges.forEach(([a,c])=>{if(seen.has(a)!==seen.has(c)){seen.add(a);seen.add(c);grow=true;}});}
  const floating=NODE_NAMES.map((_,i)=>!seen.has(i));
  const I={}, vn=i=>i>=0?V[i]:0;
  const gcur=n=>{const g=gi[n];return g.tie?G_SW*(vn(g.a)-vn(g.c)):g.dis?0:Id[g.idx];};
  I.D3=gcur('D3'); I.D2=gcur('D2'); I.D4=gcur('D4'); I.D5=gcur('D5'); I.D1=Id[i1]; I.C1=Id[ic]; I.C2=Id[ic+1]; I.C3=Id[ic+2];
