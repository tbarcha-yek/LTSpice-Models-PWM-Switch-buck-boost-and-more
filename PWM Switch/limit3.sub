const NUM={i1:[0,20],i2:[0,20],i3:[0,20],vf:[0,3],vbat:[1,60],voc:[5,200]};
const inp={}; Object.keys(NUM).forEach(k=>{inp[k]=document.getElementById(k);inp[k].addEventListener('input',()=>{const v=+inp[k].value;if(Number.isFinite(v)&&v>=NUM[k][0]&&v<=NUM[k][1]){state[k]=v;update();}});});
const loadIn=document.getElementById('load');
loadIn.addEventListener('input',()=>{state.load=+loadIn.value;update();});
function syncInputs(){Object.keys(NUM).forEach(k=>{inp[k].value=state[k];});loadIn.value=state.load;}
document.getElementById('resetParams').addEventListener('click',()=>{Object.assign(state,DEF);syncInputs();update();});
try{const s=JSON.parse(localStorage.getItem('heatersim1')||'null');
  if(s&&MODES.some(m=>m.id===s.mode)&&CKT_NAMES[s.ckt]){
    const f={}; if(s.faults&&typeof s.faults==='object')for(const [k,v] of Object.entries(s.faults)){if(FAULTABLE.includes(k)&&(v==='short'||v==='open'))f[k]=v;}
    const o={mode:s.mode,ckt:s.ckt,swap:!!s.swap,m2:!!s.m2,m3:!!s.m3,faults:f};
    Object.keys(NUM).forEach(k=>{const v=+s[k];if(Number.isFinite(v)&&v>=NUM[k][0]&&v<=NUM[k][1])o[k]=v;});
    if(Number.isFinite(+s.load)&&s.load>=0&&s.load<=3)o.load=+s.load;
    Object.assign(state,o);}
}catch(e){}
syncInputs();

const fA=v=>{const a=Math.abs(v);if(a>=1000)return (v/1000).toFixed(2)+' kA';if(a>=10)return v.toFixed(1)+' A';return (a<I_MIN?0:v).toFixed(3)+' A';};
const fV=v=>(Math.abs(v)<5e-3?0:v).toFixed(2)+' V';
const fW=v=>v>=1000?(v/1000).toFixed(1)+' kW':v.toFixed(1)+' W';
function hexrgb(h){h=h.trim();if(h[0]==='#'){if(h.length===4)h='#'+h[1]+h[1]+h[2]+h[2]+h[3]+h[3];return [1,3,5].map(i=>parseInt(h.slice(i,i+2),16));}
  const m=h.match(/\d+/g);return m?m.slice(0,3).map(Number):[128,128,128];}
function loopColors(){const cs=getComputedStyle(document.documentElement);const o={};['ckt1','ckt2','ckt3','bat'].forEach(k=>{o[k]=hexrgb(cs.getPropertyValue('--d-'+k)||'#888');});return o;}
const blend=(parts,cols)=>{let r=0,g=0,b=0,w=0;parts.forEach(([k,v])=>{const c=cols[k];if(!c)return;r+=c[0]*v;g+=c[1]*v;b+=c[2]*v;w+=v;});return w?[r/w,g/w,b/w].map(Math.round):[128,128,128];};
const rgba=(c,a)=>`rgba(${c[0]},${c[1]},${c[2]},${a})`;
function midpoint(pts){let L=0;const segL=[];for(let i=1;i<pts.length;i++){const d=Math.hypot(pts[i][0]-pts[i-1][0],pts[i][1]-pts[i-1][1]);segL.push(d);L+=d;}
  let t=L/2;for(let i=0;i<segL.length;i++){if(t<=segL[i]){const a=pts[i],b=pts[i+1],u=t/segL[i];return {x:a[0]+(b[0]-a[0])*u,y:a[1]+(b[1]-a[1])*u,ang:Math.atan2(b[1]-a[1],b[0]-a[0])*180/Math.PI,L};}t-=segL[i];}
  return {x:pts[0][0],y:pts[0][1],ang:0,L};}

function update(){
  try{localStorage.setItem('heatersim1',JSON.stringify(state));}catch(e){}
  const mode=MODES.find(m=>m.id===state.mode);
  const prop=state.ckt==='proposed', sw=state.swap;
  const heaterStr=sw?{short:'CKT 3',i:state.i3}:{short:'CKT 2',i:state.i2};
  const busStr   =sw?{short:'CKT 2',i:state.i2}:{short:'CKT 3',i:state.i3};
  srcLbl.ckt3.textContent=busStr.short; srcLbl.ckt2.textContent=heaterStr.short;
  document.getElementById('lg-ckt2').innerHTML='<i style="background:var(--d-ckt2)"></i>'+heaterStr.short+' loop'; document.getElementById('lg-ckt3').innerHTML='<i style="background:var(--d-ckt3)"></i>'+busStr.short+' loop';
  document.getElementById('sw-i2').style.background=sw?'var(--d-ckt3)':'var(--d-ckt2)'; document.getElementById('sw-i3').style.background=sw?'var(--d-ckt2)':'var(--d-ckt3)';
  const swb=document.getElementById('swap'); swb.classList.toggle('on',sw); swb.setAttribute('aria-pressed',sw);
  const p={ckt:state.ckt,faults:state.faults,I1:state.i1*mode.irr,I2:heaterStr.i*mode.irr,I3:busStr.i*mode.irr,m2:state.m2,m3:state.m3,t1:mode.t1,t2:mode.t2,load:state.load,voc:state.voc,vbat:state.vbat,vf:state.vf};
  const r=solve(p); const {V,I,floating,open}=r;
  const flow=decompose(I,state.ckt), cols=loopColors();
  MODES.forEach(m=>{const b=document.getElementById('mode-'+m.id);b.classList.toggle('on',m.id===state.mode);b.setAttribute('aria-pressed',m.id===state.mode);});
  Object.keys(CKT_NAMES).forEach(c=>{const b=document.getElementById('ckt-'+c);b.classList.toggle('on',state.ckt===c);b.setAttribute('aria-pressed',state.ckt===c);});
  d5sym.style.display=prop?'none':'';
  dot600.style.display=prop?'none':''; vEl[8].g.style.display=prop?'':'none';
  const shown={D3:true,D2A:!prop,D2A_p:prop,D2B:true,D1:!prop};
  document.getElementById('pbox2').style.display=prop?'none':'';
  vEl[3].t.setAttribute('x',prop?xM+10:xA+12); vEl[3].t.setAttribute('y',prop?273:154); vEl[3].r.setAttribute('x',prop?xM+5:xA+7); vEl[3].r.setAttribute('y',prop?261:142);
  iEl.D2.t.setAttribute('x',prop?xM-14:425); iEl.D2.t.setAttribute('y',prop?246:187); iEl.D2.t.setAttribute('text-anchor',prop?'end':'middle'); iEl.D2.seg=prop?'m1a':'d2';
  const present=new Set(Object.entries(shown).filter(([,v])=>v).map(([k])=>k));
  Object.entries(dEl).forEach(([k,d])=>{const f=state.faults[d.name]||'ok';d.g.style.display=shown[k]?'':'none';d.g.classList.toggle('dead',f==='open');
    d.badge.style.display=f==='ok'?'none':'';d.bt.style.display=f==='ok'?'none':'';d.bt.textContent=f==='short'?'S':'O';d.g.setAttribute('aria-label',d.name+' '+(f==='ok'?'OK':f));});
  const fl=Object.entries(state.faults);
  document.getElementById('faultList').innerHTML=fl.length?fl.map(([n,f])=>`<li><span>${n}${present.has(n)?'':' <span style="color:var(--muted)">(not in this circuit)</span>'}</span><span class="fs">${f==='short'?'shorted':'open'}</span></li>`).join(''):'<li><span style="color:var(--muted)">No faults injected</span></li>';
  document.getElementById('envT').textContent=mode.T;
  document.getElementById('envIrr').textContent=mode.irr?'1 Sun':'dark';
  document.getElementById('envT1').innerHTML=`<span class="pill ${mode.t1?'closed':'open'}">${mode.t1?'CLOSED':'OPEN'}</span>`;
  document.getElementById('envT2').innerHTML=`<span class="pill ${mode.t2?'closed':'open'}">${mode.t2?'CLOSED':'OPEN'}</span>`;
  document.getElementById('loadV').textContent=state.load.toFixed(2)+' A';
  document.getElementById('battLbl').textContent=state.vbat.toFixed(state.vbat%1?1:0)+'V';
  [['M2',state.m2,heaterStr.short],['M3',state.m3,busStr.short]].forEach(([n,on,who])=>{const b=document.getElementById('btn'+n);b.classList.toggle('on',on);b.querySelector('b').textContent=n+' · '+who;b.querySelector('small').textContent=on?'ON · shunted':'OFF · feeds the bus';
    fetEl[n].g.classList.toggle('on',on);fetEl[n].g.setAttribute('aria-pressed',on);fetEl[n].st2.textContent=on?'ON (shunted)':'OFF';});
  tsEl.t2.g.style.display=prop?'':'none'; tsEl.t2b.g.style.display=prop?'none':'';
  [['t1',mode.t1],['t2',mode.t2],['t2b',mode.t2]].forEach(([n,cl])=>{tsEl[n].g.classList.toggle('open',!cl);tsEl[n].st.textContent=cl?'CLOSED':'OPEN';tsEl[n].st.setAttribute('class','st '+(cl?'closed':'open'));});
  const segColor={};
  SEGS.forEach(s=>{const e=segEl[s.id];const hidden=s.only&&!s.only.includes(state.ckt);
    const i=s.cur(I), f=flow[s.id], on=!hidden&&!!f&&f.cap>=I_MIN;
    const parts=on?Object.entries(f.contrib).filter(([,v])=>Math.abs(v)>=I_MIN).sort((a,b)=>Math.abs(b[1])-Math.abs(a[1])):[];
    if(on&&f.res>=I_MIN) parts.push(['rest',f.res]);
    const col=on?blend(parts.map(([k,v])=>[k,Math.abs(v)]),cols):null; segColor[s.id]=col;
    const w=2.4+Math.min(2.6,Math.abs(i)*1.5);
    e.base.style.display=hidden?'none':''; e.glow.style.display=on?'':'none'; e.arrow.style.display=(on&&!s.noArrow&&midpoint(s.pts).L>=40)?'':'none';
    e.base.style.stroke=on?rgba(col,0.35):''; e.base.style.strokeWidth=on?w+'px':'';
    if(on){e.glow.style.stroke=rgba(col,0.16);e.glow.style.strokeWidth=(w+8)+'px';}
    while(e.dashes.length<parts.length)e.dashes.push(el('polyline',{class:'dash',points:e.pts},gDash));
    const d=10,gap=6,P=parts.length*d+gap, dur=Math.max(450,1900/Math.max(Math.abs(i),1e-3)), rev=i<0;
    e.dashes.forEach((pl,j)=>{pl.getAnimations().forEach(a=>a.cancel());
      if(j>=parts.length||!on){pl.style.display='none';return;}
      pl.style.display='';const [k,v]=parts[j];pl.style.stroke=k==='rest'?'var(--muted)':rgba(cols[k],1);pl.style.strokeWidth=w+'px';
      pl.setAttribute('stroke-dasharray',`${d} ${P-d}`);const start=-j*d;pl.setAttribute('stroke-dashoffset',start);const prev=rev!==(v<0);
      if(!reduced.matches)pl.animate([{strokeDashoffset:start+'px'},{strokeDashoffset:(start+(prev?P:-P))+'px'}],{duration:dur,iterations:Infinity});});
    if(on&&!s.noArrow){const m=midpoint(s.pts);e.arrow.setAttribute('transform',`translate(${m.x.toFixed(1)},${m.y.toFixed(1)}) rotate(${(m.ang+(rev?180:0)).toFixed(1)})`);e.arrow.style.fill=rgba(col,1);e.arrow.style.stroke='var(--panel)';e.arrow.style.strokeWidth='1px';}
  });
  NODE_NAMES.forEach((n,i)=>{const c=vEl[i];if(!c)return;const fl=floating[i];c.g.classList.toggle('float',fl);c.b.textContent=(fl?'≈':'')+fV(V[i]);
    try{const w=c.t.getComputedTextLength();if(w>0)c.r.setAttribute('width',(w+10).toFixed(1));}catch(e){}});
  const setI=(k,v)=>{const c=iEl[k];c.t.textContent=fA(v);const col=segColor[c.seg];c.t.style.fill=(Math.abs(v)>=I_MIN&&col)?rgba(col,1):'';};
  setI('D3',I.D3);setI('M3',I.M3);setI('D2',I.D2);setI('M2',I.M2);setI('D4',I.D4);setI('aux',I.aux);setI('main',I.main);setI('D5',I.D5);setI('load',I.load);
  setI('ckt3',I.ckt3);setI('ckt2',I.ckt2);setI('ckt1',I.ckt1);
  iEl.bat.t.textContent=(I.bat>=0?'+':'')+fA(I.bat)+' '+(Math.abs(I.bat)<I_MIN?'':I.bat>0?'chg':'dis');iEl.bat.t.style.fill=(Math.abs(I.bat)>=I_MIN&&segColor.bat2)?rgba(segColor.bat2,1):'';
  const Paux=I.aux*I.aux*RH, Pmain=I.main*I.main*RH;
  const ckt1open=mode.irr>0&&I.C1>1e-4;
  document.getElementById('resTitle').textContent='Readouts · '+CKT_NAMES[state.ckt]+(sw?' · CKT 2/3 swapped':'')+' · '+mode.name;
  document.getElementById('results').innerHTML=[
    ['Battery',(Math.abs(I.bat)>=I_MIN&&I.bat>0?'+':'')+fA(I.bat),I.bat>=I_MIN?'charging':I.bat<=-I_MIN?'discharging':'idle'],
    ['Bus from array',fA(I.D3+I.D4),'D3 + D2B'],
    ['MAIN HTR node',(floating[3]?'≈':'')+fV(V[3]),V[3]>state.vbat+1e-3?'above the battery':(state.vbat-V[3]).toFixed(1)+' V under the battery'],
    ['AUX HTR',fW(Paux),fA(I.aux)+' · '+fV(I.aux*RH)],
    ['MAIN HTR',fW(Pmain),fA(I.main)+' · '+fV(I.main*RH)],
    ['CKT 1 string',ckt1open&&!mode.t1?'open':fA(I.ckt1),ckt1open?(mode.t1?'limited by its Voc ('+fV(state.voc/2)+')':'at Voc, no return path'):'delivered to the AUX loop'],
  ].map(([k,v,s])=>`<div class="kv"><div class="k">${k}</div><div class="v">${v}</div><div class="k" style="text-transform:none;letter-spacing:0">${s}</div></div>`).join('');
  const alerts=[];
  if(I.M2>10) alerts.push(`Bus short through M2 (${fA(I.M2)}): a shorted bus-side diode puts the battery on N2.`);
  if(I.M3>10) alerts.push(`Bus short through M3 (${fA(I.M3)}): shorted D3 puts the battery on N3.`);
  if(I.D4<-1e-3) alerts.push(`Battery is back-feeding through shorted D2B: ${fW(Pmain)} in the MAIN HTR from the battery${!prop&&I.aux>1e-3?', '+fW(Paux)+' in the AUX HTR':''}.`);
  if(r.viol>1e-6) alerts.push('Solver could not find a fully consistent diode state; values are a best fit.');
  document.getElementById('alerts').innerHTML=alerts.map(a=>`<div class="alert">⚠ ${a}</div>`).join('');
}
function fit(){const W=1920,H=1080,s=Math.min(innerWidth/W,innerHeight/H);document.getElementById('stage').style.transform=`translate(${((innerWidth-W*s)/2).toFixed(1)}px,${((innerHeight-H*s)/2).toFixed(1)}px) scale(${s.toFixed(4)})`;}
addEventListener('resize',fit); fit();
update();
if(document.fonts&&document.fonts.ready)document.fonts.ready.then(update);
matchMedia('(prefers-color-scheme: dark)').addEventListener('change',update);
new MutationObserver(update).observe(document.documentElement,{attributes:true,attributeFilter:['data-theme']});
reduced.addEventListener('change',update);
})();
</script>
</body>
</html>
